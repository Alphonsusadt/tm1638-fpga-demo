# ==========================================
# iCESugar v1.5 - TM1638 Wiring Constraints
# ==========================================

# System Clock (On-board 12MHz)
set_io clk 35

# ------------------------------------------
# TM1638 Interface (Connected to PMOD 1)
# ------------------------------------------
# Mapping berdasarkan instruksi gambar:
# STB -> PMOD 1 Pin 12 -> FPGA Pin 9
# CLK -> PMOD 1 Pin 11 -> FPGA Pin 4
# DIO -> PMOD 1 Pin 10 -> FPGA Pin 2

set_io tm_cs 9
set_io tm_clk 4
set_io tm_dio 2

# ------------------------------------------
# Optional: On-board LEDs (Untuk Debugging)
# ------------------------------------------
# Jika kamu ingin menyalakan LED onboard saat program berjalan
set_io LED_G 41
set_io LED_R 40
set_io LED_B 39